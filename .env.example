# ===== MySQL =====
# 建议使用仅含字母、数字、下划线的强随机串（密码会拼进 DATABASE_URL）
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# ===== Dify Workflow =====
# Dify Cloud 使用 https://api.dify.ai/v1；自建 Dify 填自己的 /v1 地址
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-your-workflow-key

# 工作流变量名（与 Dify Start / End 节点保持一致）
DIFY_FILE_INPUT=ppt_file
DIFY_VOICE_INPUT=voice
DIFY_SPEED_INPUT=speed
DIFY_AUDIO_OUTPUT=audio
DIFY_TEXT_OUTPUT=transcript
# blocking 或 streaming；长耗时工作流建议 streaming
DIFY_RESPONSE_MODE=streaming

# 音频下载额外白名单（逗号分隔）；Dify 同源域名始终允许
# 若 Dify 生成的音频在独立对象存储域名，请在此追加，例如：upload.dify.ai
DIFY_AUDIO_ALLOWED_HOSTS=

# 超时与重试（秒）
DIFY_CONNECT_TIMEOUT=10
DIFY_READ_TIMEOUT=600
DIFY_TOTAL_TIMEOUT=660
DIFY_MAX_RETRIES=3
DIFY_RETRY_BACKOFF=1.5

# ===== 本地演示模式 =====
# true 时不调用真实 Dify，生成示例文稿和一段短音频，便于无 Key 演示
# 正式环境必须保持 false
MOCK_DIFY=false
MOCK_DIFY_DELAY=1.5

# ===== 上传与视频合成 =====
# 上传上限（字节）：PPTX 50 MB，数字人图片 10 MB
MAX_UPLOAD_BYTES=52428800
AVATAR_MAX_BYTES=10485760
# 输出视频：默认 1280×720，H.264 + AAC，最大 500 MB
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_MAX_BYTES=524288000
VIDEO_RENDER_TIMEOUT=1800
# 镜像内已内置静态 ffmpeg / ffprobe，通常无需修改
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ===== 其他 =====
STORAGE_BACKEND=local
LOG_LEVEL=INFO

# Web 对外端口；若 8080 被占用可改为 8088 等
WEB_PORT=8080

# ===== 镜像源（可选）=====
# 无法直连 Docker Hub（如 IPv6 不通）时，取消注释并改用镜像源
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
# PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# apt 安装 ffmpeg 不可用时，可改用静态 ffmpeg 镜像
# FFMPEG_IMAGE=mwader/static-ffmpeg:7.1
